# LMS Backend — customer deployment configuration
# Copy this file to `.env` in the same folder and fill in the values below
# before running the packaged application. Never commit a real .env.

# ── Database (required) ──────────────────────────────────────────────────
# PostgreSQL connection string for this customer's database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Secrets (required — generate fresh values per customer, never reuse) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-strong-random-value
JWT_SECRET_KEY=changeme-generate-a-different-strong-random-value
# Optional. Must be a valid Fernet key; leave empty to derive one from JWT_SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRM_ENCRYPTION_KEY=

# ── Deployment ──────────────────────────────────────────────
# onprem turns on the desktop/offline behaviour (no email-code login, SPA served by the backend)
DEPLOYMENT_MODE=onprem
# Customer portal URL; leave empty to keep the portal module hidden
CSSP_PORTAL_URL=
# Optional: a module (on the Python path) that registers on-prem deployment hooks at startup
# DEPLOYMENT_HOOKS_MODULE=
# Turn features on or off for this install only, e.g. FEATURE_FLAGS=audits=on,online_payment=off
# (the product defaults are in features.json, see the Features page of the on-prem docs)
# FEATURE_FLAGS=

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
DEBUG=False
ENVIRONMENT=production
APP_NAME=LMS Backend
APP_VERSION=1.0.0

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email domains allowed to self-register (comma-separated) ──────────────
# Add this customer's own company domain(s) here.
ALLOWED_REGISTRATION_DOMAINS=@millenniumtechlink.com,@millenniumtestlabs.com,@millenniumsemi.com,@tataadvancedsystems.com,@gmail.com,@test.com,@example.com

# ── Database pool ─────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── CORS — the origin(s) the frontend is served from ─────────────────────
CORS_ORIGINS=http://localhost:8001

# ── File storage ──────────────────────────────────────────────────────────
STORAGE_TYPE=local
# Multi-client on-prem? See the Samba section below.
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/jpg

# ── Optional: Samba file share (multi-client on-prem only) ────────────────
# UPLOAD_DIR becomes a UNC path (e.g. //192.168.1.103/lms-uploads); these
# are the share's service-account login. Get all three from
# server-setup-ubuntu/output/client.env.generated, not made up.
# LMS_SVC_SMB_USER=
# LMS_SVC_SMB_PASSWORD=

# ── Optional: S3 storage (only if STORAGE_TYPE=s3) ────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=

# ── Optional: outbound email (leave unset to disable) ─────────────────────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# ── Optional: AI chatbot (leave unset to disable) ──────────────────────────
# OPENAI_API_KEY=
# CHAT_MODEL=gpt-4o-mini

# ── Optional: CRM sync (Salesforce/HubSpot) ────────────────────────────────
# BASE_URL must be this server's real reachable address, not localhost -
# it's used for the OAuth callback these integrations redirect back to.
# BASE_URL=http://<server-ip>:8001
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# ── Optional: lab recommendation engine (separate DB, only if used) ──────
# LAB_ENGINE_DATABASE_URL=
